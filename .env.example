NODE_ENV=development
PORT=5000

# Production persistence. Without this, Strango uses data/strango-db.json.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=strango
MONGODB_POOL_SIZE=10

# Google OAuth 2.0
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/auth/google/callback

# Passwordless email login via Resend
RESEND_API_KEY=
EMAIL_FROM=Strango <login@example.com>

# Optional label for a future LLM-backed summary provider.
AI_SUMMARY_PROVIDER=extractive-v1
